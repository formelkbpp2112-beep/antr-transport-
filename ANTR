      {query.isError ? <div className="p-5"><ErrorPanel message={String((query.error as Error)?.message ?? '')} retry={() => void query.refetch()} /></div>
        : query.isLoading ? <RecordSkeleton />
          : records.length ? <div className="table-scroll"><table className="w-full min-w-[760px] border-collapse text-left">
            <thead><tr className="bg-[#f7f5ee] text-[10px] font-bold uppercase tracking-[.12em] text-[#81867d]"><th className="px-5 py-3">Conducteur</th><th className="px-4 py-3">Véhicule</th><th className="px-4 py-3">Permis démo</th><th className="px-4 py-3">Date</th><th className="px-4 py-3">Montant exemple</th><th className="px-5 py-3 text-right">Contrôle</th></tr></thead>
            <tbody>{records.map(record => <tr key={record.id} className="border-t border-[#eee9df] transition-colors hover:bg-[#faf9f4]" data-testid={`table-record-${record.id}`}>
              <td className="px-5 py-4"><div className="text-[13px] font-bold text-[#283a33]">{record.driverName}</div><div className="mono mt-1 text-[11px] text-[#82877e]">{record.licensePlate}</div></td>
               <td className="px-4 py-4"><div className="inline-flex items-center gap-2 text-xs text-[#59645d]">{(() => { const Icon = categoryIcons[record.vehicleCategory]; return <Icon size={15} />; })()}{record.categoryLabel || categoryNames[record.vehicleCategory]}</div><div className="mt-1 text-[11px] text-[#80867c]">{record.vehicleMake} {record.vehicleModel} · {record.vehicleYear ?? '—'} · {record.wheelCount ?? '—'} roues</div></td>
              <td className="mono px-4 py-4 text-xs text-[#637168]">{record.permitNumber}</td>
               <td className="px-4 py-4 text-xs text-[#777e75]"><div>{record.serviceDate}</div><div className="mt-1 text-[10px]">{record.shiftStart ?? '—'}–{record.shiftEnd ?? '—'}</div></td>
              <td className="mono px-4 py-4 text-xs text-[#4d655a]">{money(record.amountFc)} <span className="font-sans text-[10px] text-[#999b91]">démo</span></td>
              <td className="px-5 py-4 text-right"><Link href={record.verificationPath || `/verify/${record.id}`} className="inline-flex items-center gap-1.5 rounded-lg border border-[#d3e0d4] bg-[#eff4ed] px-3 py-2 text-xs font-bold text-[#286551] no-underline hover:bg-[#e4eee3]" data-testid={`button-open-verify-${record.id}`}>Vérifier <ArrowRight size={13} /></Link></td>
            </tr>)}</tbody>
          </table></div>
            : <EmptyRecords />}
    </section>
    <div className="mt-4 text-[11px] leading-relaxed text-[#8b8d83]">Tous les dossiers et montants de ce registre sont fictifs, à des fins de démonstration uniquement.</div>
  </div>;
}

function NewRecord() {
  const queryClient = useQueryClient();
  const create = useCreateTransportRecord();
  const [receipt, setReceipt] = useState<TransportRecord | null>(null);
  const [lookupPermit, setLookupPermit] = useState('');
  const form = useForm<RecordFormValues>({
    resolver: zodResolver(recordFormSchema),
    defaultValues: {
      driverName: '',
      permitNumber: '',
      licensePlate: '',
      vehicleMake: 'Toyota',
      vehicleModel: 'IST',
      vehicleYear: 2007,
      wheelCount: 4,
      vehicleCategory: 'taxi',
      serviceDate: todayInKinshasa(),
      shiftStart: '06:00',
      shiftEnd: '18:00',
    },
  });
  const [validation, setValidation] = useState('');
  const permitText = form.watch('permitNumber');
  useEffect(() => {
    const value = permitText.trim();
    if (value.length < 4) {
      setLookupPermit('');
      return;
    }
    const timer = window.setTimeout(() => setLookupPermit(value), 350);
    return () => window.clearTimeout(timer);
  }, [permitText]);
  const permitLookup = useListTransportRecords(
    { search: lookupPermit || '__demo_permit_lookup_disabled__' },
    {
      query: {
        queryKey: getListTransportRecordsQueryKey({
          search: lookupPermit || '__demo_permit_lookup_disabled__',
        }),
        enabled: lookupPermit.length >= 4,
        staleTime: 30_000,
      },
    },
  );
  const permitMatches = useMemo(() => {
    const currentPermit = normalizePermit(permitText);
    if (
      currentPermit.length < 4 ||
      normalizePermit(lookupPermit) !== currentPermit
    ) {
      return [];
    }
    return (permitLookup.data ?? []).filter(
      record => normalizePermit(record.permitNumber) === currentPermit,
    );
  }, [lookupPermit, permitLookup.data, permitText]);
  const permitNameConflict =
    new Set(permitMatches.map(record => record.driverName.trim().toLowerCase()))
      .size > 1;
  const matchedPermitRecord = permitNameConflict ? undefined : permitMatches[0];
  useEffect(() => {
    if (!matchedPermitRecord) return;
    form.setValue('driverName', matchedPermitRecord.driverName, {
      shouldValidate: true,
    });
    if (matchedPermitRecord.vehicleMake) {
      form.setValue('vehicleMake', matchedPermitRecord.vehicleMake, {
        shouldValidate: true,
      });
    }
    if (matchedPermitRecord.vehicleModel) {
      form.setValue('vehicleModel', matchedPermitRecord.vehicleModel, {
        shouldValidate: true,
      });
    }
    if (matchedPermitRecord.vehicleYear) {
      form.setValue('vehicleYear', matchedPermitRecord.vehicleYear, {
        shouldValidate: true,
      });
    }
    if (matchedPermitRecord.wheelCount) {
      form.setValue('wheelCount', matchedPermitRecord.wheelCount, {
        shouldValidate: true,
      });
    }
    form.setValue(
      'vehicleCategory',
      inputCategoryForRecord(matchedPermitRecord.vehicleCategory),
      { shouldValidate: true },
    );
  }, [matchedPermitRecord?.id]);
  const submit = form.handleSubmit(values => {
    setValidation('');
    create.mutate({
      data: {
        ...values,
        licensePlate: values.licensePlate.toUpperCase(),
      },
    }, {
      onSuccess: record => {
        setReceipt(record);
        void queryClient.invalidateQueries({ queryKey: getListTransportRecordsQueryKey() });
        void queryClient.invalidateQueries({ queryKey: getGetDashboardSummaryQueryKey() });
        void queryClient.invalidateQueries({ queryKey: getGetTransportRecordQueryKey(record.id) });
        void queryClient.invalidateQueries({ queryKey: getVerifyTransportRecordQueryKey(record.id) });
      },
      onError: error => {
        const apiError = error as Error & { status?: number; data?: { error?: string } };
        const detail = String(apiError.data?.error ?? apiError.message ?? '');
        const isConflict = apiError.status === 409 || /409|conflict/i.test(detail);
        if (/permis/i.test(detail)) {
          setValidation(detail);
        } else if (isConflict || /chevauch|créneau|horaire/i.test(detail)) {
          setValidation('Ce véhicule possède déjà un créneau qui chevauche ces heures. Choisissez un autre horaire.');
        } else {
          setValidation(detail || 'L’enregistrement a échoué. Vérifiez les informations et réessayez.');
        }
      },
    });
  });
  if (receipt) return <Receipt record={receipt} onNew={() => { setReceipt(null); form.reset(); setValidation(''); }} />;
  const categories = categoryChoices;
  const suggestions = vehicleSuggestions[form.watch('vehicleCategory')];
  return <div className="page-enter">
    <PageHeading eyebrow="Nouvel exemple" title="Enregistrer un reçu démo" description="Saisissez les informations du véhicule. Un enregistrement de démonstration sera créé, sans paiement." />
    <div className="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_310px]">
      <Form {...form}>
        <form onSubmit={submit} className="rounded-2xl border border-[#e4dfd2] bg-[#fffdf8] p-5 sm:p-7" data-testid="form-new-record">
          <div className="mb-6 flex items-center gap-3 border-b border-[#ece7dc] pb-5"><div className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#e5eee5] text-[#246b58]"><FilePlus2 size={19} /></div><div><div className="text-sm font-bold text-[#2d3e36]">Informations du dossier</div><div className="mt-1 text-xs text-[#898b81]">Champs requis · utilisés pour cet exemple uniquement</div></div></div>
          {validation && <div role="alert" className="mb-5 rounded-xl border border-[#ecc6b7] bg-[#fff3ee] p-3 text-xs leading-relaxed text-[#804735]" data-testid="status-create-error">{validation}</div>}
          <datalist id="vehicle-makes">{suggestions.makes.map(make => <option key={make} value={make} />)}</datalist>
          <datalist id="vehicle-models">{suggestions.models.map(model => <option key={model} value={model} />)}</datalist>
          <div className="grid gap-5 sm:grid-cols-2">
            <FormField control={form.control} name="driverName" render={({ field }) => (
              <FormItem>
                <FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Nom du conducteur</FormLabel>
                <FormControl><input {...field} className="field-input" placeholder="Ex. Conducteur démo 04" autoComplete="off" data-testid="input-driver-name" /></FormControl>
                <FormMessage />
              </FormItem>
            )} />
            <FormField control={form.control} name="permitNumber" render={({ field }) => (
              <FormItem>
                <FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Numéro de permis (démo)</FormLabel>
                <FormControl><input {...field} className="field-input" placeholder="Ex. DEM-PERMIS-0004" autoComplete="off" data-testid="input-permit-number" /></FormControl>
                <FormMessage />
                {permitText.trim().length >= 4 && normalizePermit(lookupPermit) === normalizePermit(permitText) && (
                  permitLookup.isFetching
                    ? <p className="mt-2 text-[11px] text-[#717b86]" role="status" data-testid="status-permit-lookup">Recherche parmi les exemples fictifs…</p>
                    : permitLookup.isError
                      ? <p className="mt-2 text-[11px] text-[#8b6044]" role="status" data-testid="status-permit-lookup">Recherche démo indisponible. Vous pouvez continuer avec des données fictives.</p>
                      : permitNameConflict
                        ? <p className="mt-2 text-[11px] leading-relaxed text-[#9a4b36]" role="alert" data-testid="status-permit-lookup">Ce numéro de permis démo apparaît avec plusieurs noms. Vérifiez les informations avant de continuer.</p>
                        : permitMatches.length
                          ? <p className="mt-2 text-[11px] leading-relaxed text-[#1769aa]" role="status" data-testid="status-permit-lookup">Exemple correspondant trouvé : le conducteur et le véhicule ont été préremplis. Vérifiez les champs avant de créer un nouveau reçu.</p>
                          : <p className="mt-2 text-[11px] text-[#717b86]" role="status" data-testid="status-permit-lookup">Aucun exemple ne correspond à ce numéro.</p>
                )}
              </FormItem>
            )} />
            <FormField control={form.control} name="licensePlate" render={({ field }) => (
              <FormItem>
                <FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Plaque (fictive)</FormLabel>
                <FormControl><input {...field} className="field-input" placeholder="Ex. DEMO-04" autoComplete="off" data-testid="input-license-plate" /></FormControl>
                <FormMessage />
              </FormItem>
            )} />
            <FormField control={form.control} name="vehicleMake" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Marque du véhicule</FormLabel><FormControl><input {...field} list="vehicle-makes" className="field-input" placeholder="Saisissez ou choisissez une marque" autoComplete="off" data-testid="input-vehicle-make" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="vehicleModel" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Modèle du véhicule</FormLabel><FormControl><input {...field} list="vehicle-models" className="field-input" placeholder="Saisissez ou choisissez un modèle" autoComplete="off" data-testid="input-vehicle-model" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="vehicleYear" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Année du véhicule</FormLabel><FormControl><input {...field} type="number" min="1950" max="2100" className="field-input" data-testid="input-vehicle-year" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="wheelCount" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Nombre de roues</FormLabel><FormControl><input {...field} type="number" min="2" max="18" className="field-input" data-testid="input-wheel-count" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="vehicleCategory" render={({ field }) => (
              <FormItem className="sm:col-span-2">
                <FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Catégorie de véhicule</FormLabel>
                <FormControl>
                  <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" role="group" aria-label="Catégorie de véhicule">
                    {categories.map(category => {
                      const Icon = categoryIcons[category];
                      const selected = field.value === category;
                      return <button key={category} type="button" aria-pressed={selected} onClick={() => field.onChange(category)}
                        className={`flex min-h-[74px] items-center gap-3 rounded-xl border px-3.5 text-left transition-colors ${selected ? 'border-[#5c9985] bg-[#edf4ed] text-[#1d634f]' : 'border-[#e4dfd2] bg-[#fffdf8] text-[#5d6c62] hover:bg-[#f6f4ed]'}`}
                        data-testid={`button-category-${category}`}>
                        <span className={`flex h-9 w-9 items-center justify-center rounded-lg ${selected ? 'bg-[#d8e9dc]' : 'bg-[#f0eee5]'}`}><Icon size={18} /></span>
                        <span className="flex-1"><span className="block text-xs font-bold">{categoryNames[category]}</span><span className="mt-1 block text-[10px] text-[#8a8d82]">{categoryDescriptions[category]}</span></span>
                        {selected && <Check size={15} />}
                      </button>;
                    })}
                  </div>
                </FormControl>
                <FormMessage />
              </FormItem>
            )} />
            <FormField control={form.control} name="serviceDate" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Date de service</FormLabel><FormControl><input {...field} type="date" className="field-input" data-testid="input-service-date" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="shiftStart" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Début du service</FormLabel><FormControl><input {...field} type="time" className="field-input" data-testid="input-shift-start" /></FormControl><FormMessage /></FormItem>
            )} />
            <FormField control={form.control} name="shiftEnd" render={({ field }) => (
              <FormItem><FormLabel className="mb-2 block text-[13px] font-bold text-[#34453e]">Fin du service</FormLabel><FormControl><input {...field} type="time" className="field-input" data-testid="input-shift-end" /></FormControl><FormMessage /></FormItem>
            )} />
            <div className="sm:col-span-2 flex items-center justify-between rounded-xl border border-[#d8dce2] bg-[#f1f4f7] px-4 py-3" aria-live="polite" data-testid="text-category-amount">
              <span className="text-xs font-semibold text-[#526174]">Montant indicatif calculé par catégorie</span>
              <strong className="mono text-sm text-[#173c68]">{money(categoryRates[form.watch('vehicleCategory')])}</strong>
            </div>
          </div>
          <div className="mt-6"><DemoNotice compact /></div>
          <button type="submit" disabled={create.isPending} className="btn-primary mt-6 flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3.5 text-sm font-bold" data-testid="button-submit-record">
            {create.isPending ? <><span className="h-4 w-4 animate-pulse rounded-full border-2 border-white/40 border-t-white" /> Enregistrement de démonstration…</> : <>Créer le reçu de démonstration <ArrowRight size={16} /></>}
          </button>
        </form>
      </Form>
      <aside className="space-y-4">
        <div className="rounded-2xl bg-[#164f43] p-5 text-[#f3f0e5]">
          <div className="mb-4 flex items-center gap-2 text-[#e6bf91]"><ShieldCheck size={17} /><span className="text-[10px] font-bold uppercase tracking-[.16em]">Ce que fait cet outil</span></div>
          <p className="m-0 text-[13px] leading-relaxed text-[#e2e9de]">Il sauvegarde les informations d’un exemple et permet de confirmer ce même enregistrement avec son lien de vérification.</p>
          <div className="mt-5 space-y-3 border-t border-white/15 pt-4 text-xs text-[#cadbd0]">
            <div className="flex items-center gap-2.5"><Check size={14} className="text-[#e5bc8c]" /> Reçu numérique de démonstration</div>
            <div className="flex items-center gap-2.5"><Check size={14} className="text-[#e5bc8c]" /> Lien unique de contrôle</div>
            <div className="flex items-center gap-2.5"><X size={14} className="text-[#e5bc8c]" /> Aucun paiement effectué</div>
          </div>
        </div>
        <div className="rounded-2xl border border-[#e4dfd2] bg-[#fffdf8] p-5"><div className="text-xs font-bold text-[#35473e]">Données demandées</div><p className="mb-0 mt-2 text-xs leading-relaxed text-[#83877e]">Ce prototype conserve les données saisies. N’utilisez que des exemples fictifs — ne saisissez pas de renseignements personnels réels.</p></div>
      </aside>
    </div>
  </div>;
}

function Receipt({ record, onNew }: { record: TransportRecord; onNew: () => void }) {
  const path = record.verificationPath || `/verify/${record.id}`;
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
  const href = path.startsWith('http')
    ? path
    : `${window.location.origin}${basePath}${path.startsWith('/') ? path : `/${path}`}`;
  return <div className="page-enter mx-auto max-w-[860px]">
    <div className="mb-6"><div className="mb-2 text-[10px] font-bold uppercase tracking-[.2em] text-[#25806b]">Enregistrement terminé</div><h1 className="serif m-0 text-[30px] font-extrabold tracking-[-.04em] text-[#22332f]">Reçu de démonstration</h1><p className="mb-0 mt-2 text-sm text-[#72786f]">L’exemple a été sauvegardé. Le lien ci-dessous confirme cet enregistrement précis.</p></div>
    <div className="grid overflow-hidden rounded-2xl border border-[#ded8c9] bg-[#fffdf8] md:grid-cols-[1fr_260px]">
      <div className="p-5 sm:p-8">
        <div className="flex items-start justify-between border-b border-dashed border-[#d9d3c5] pb-5"><div><div className="text-[10px] font-bold uppercase tracking-[.18em] text-[#80867c]">ANTR Transport · Exemple</div><div className="serif mt-2 text-xl font-bold text-[#293d35]">Reçu enregistré</div></div><div className="rounded-full border border-[#e7d0b0] bg-[#fff2dd] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#9c653a]">Démonstration</div></div>
        <div className="grid gap-x-5 gap-y-5 py-6 sm:grid-cols-2">
          <ReceiptDatum label="Conducteur" value={record.driverName} />
          <ReceiptDatum label="Catégorie" value={record.categoryLabel || categoryNames[record.vehicleCategory]} />
          <ReceiptDatum label="Plaque" value={record.licensePlate} mono />
          <ReceiptDatum label="Permis (démo)" value={record.permitNumber} mono />
          <ReceiptDatum label="Véhicule" value={`${record.vehicleMake ?? ''} ${record.vehicleModel ?? ''} · ${record.vehicleYear ?? '—'}`} />
          <ReceiptDatum label="Date et plage de service" value={`${record.serviceDate} · ${record.shiftStart ?? '—'}–${record.shiftEnd ?? '—'}`} mono />
          <ReceiptDatum label="Montant illustratif" value={money(record.amountFc)} />
          <ReceiptDatum label="Enregistré le" value={dateText(record.createdAt)} />
        </div>
        <div className="border-t border-dashed border-[#d9d3c5] pt-4">
          <div className="text-[10px] font-bold uppercase tracking-[.13em] text-[#929389]">Référence du dossier démo</div>
          <div className="mono mt-1.5 break-all text-xs text-[#50635a]" data-testid="text-receipt-id">{record.id}</div>
        </div>
        <div className="mt-5"><DemoNotice compact /></div>
      </div>
      <div className="flex flex-col items-center justify-center border-t border-[#e8e2d6] bg-[#f6f4ec] p-6 text-center md:border-l md:border-t-0">
        <div className="text-[10px] font-bold uppercase tracking-[.15em] text-[#738078]">Lien de contrôle démo</div>
        <div className="mt-4 rounded-lg border border-[#ddd8ca] bg-white p-[7px]">
          <QRCodeSVG value={href} size={148} level="M" marginSize={0} title="QR code du lien de vérification de démonstration" />
        </div>
        <div className="mt-2 max-w-[200px] text-[10px] leading-relaxed text-[#878b81]">Scannez pour ouvrir la vérification de cet enregistrement démo.</div>
        <Link href={path} className="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#1b6955] px-4 py-3 text-xs font-bold text-white no-underline hover:bg-[#145340]" data-testid="link-receipt-verify"><ShieldCheck size={15} /> Ouvrir la vérification</Link>
        <button type="button" onClick={() => { void navigator.clipboard?.writeText(href); }} className="mt-2 inline-flex items-center gap-1.5 px-2 py-2 text-[11px] font-semibold text-[#687970] hover:text-[#1d6b56]" data-testid="button-copy-verification"><TicketCheck size={14} /> Copier le lien</button>
      </div>
    </div>
    <div className="mt-5 flex flex-col justify-between gap-3 sm:flex-row">
      <Link href="/records" className="inline-flex items-center justify-center gap-2 rounded-xl border border-[#d9d4c8] bg-[#fffdf8] px-4 py-3 text-sm font-bold text-[#4c5d53] no-underline hover:bg-[#f4f2e9]" data-testid="link-receipt-records"><ArrowRight className="rotate-180" size={16} /> Voir les dossiers</Link>
      <button type="button" onClick={onNew} className="btn-primary inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-bold" data-testid="button-new-after-receipt"><FilePlus2 size={16} /> Enregistrer un autre exemple</button>
    </div>
  </div>;
}
function ReceiptDatum({ label, value, mono = false }: { label: string; value: string; mono?: boolean }) {
  return <div><div className="text-[10px] font-bold uppercase tracking-[.13em] text-[#929389]">{label}</div><div className={`mt-1.5 text-[13px] font-semibold text-[#34463d] ${mono ? 'mono' : ''}`}>{value || '—'}</div></div>;
}
function Verification() {
  const params = useParams<{ recordId: string }>();
  const id = params.recordId ?? '';
  const verify = useVerifyTransportRecord(id, { query: { enabled: !!id, queryKey: getVerifyTransportRecordQueryKey(id) } });
  const recordQuery = useGetTransportRecord(id, { query: { enabled: !!id, queryKey: getGetTransportRecordQueryKey(id) } });
  const result = verify.data;
  const record = result?.record ?? recordQuery.data ?? null;
  const loading = verify.isLoading || recordQuery.isLoading;
  const failed = verify.isError && recordQuery.isError;
  return <div className="page-enter mx-auto max-w-[760px]">
    <div className="mb-6"><div className="mb-2 text-[10px] font-bold uppercase tracking-[.2em] text-[#25806b]">Point de contrôle · Kinshasa</div><h1 className="serif m-0 text-[30px] font-extrabold tracking-[-.04em] text-[#22332f]">Vérification d’un dossier</h1><p className="mb-0 mt-2 text-sm leading-relaxed text-[#72786f]">Cette page contrôle le lien vers un enregistrement de démonstration sauvegardé.</p></div>
    <div className="mb-5"><DemoNotice /></div>
    {loading ? <div className="rounded-2xl border border-[#e4dfd2] bg-[#fffdf8] p-6"><div className="skeleton h-7 w-56 rounded" /><div className="skeleton mt-4 h-4 w-full rounded" /><div className="mt-6 grid gap-3 sm:grid-cols-2">{[0,1,2,3].map(i => <div key={i} className="skeleton h-16 rounded-xl" />)}</div></div>
      : failed ? <ErrorPanel message={String((verify.error as Error)?.message ?? 'Le lien n’a pas pu être contrôlé.')} retry={() => { void verify.refetch(); void recordQuery.refetch(); }} />
        : <VerificationCard valid={!!result?.valid} message={result?.message ?? (record ? 'Cet enregistrement de démonstration est disponible.' : 'Aucun enregistrement ne correspond à ce lien.')} record={record} id={id} />}
    <Link href="/records" className="mt-5 inline-flex items-center gap-2 text-xs font-bold text-[#236c57] no-underline" data-testid="link-verification-records"><ArrowRight className="rotate-180" size={15} /> Retour au registre</Link>
  </div>;
}
function VerificationCard({ valid, message, record, id }: { valid: boolean; message: string; record: TransportRecord | null; id: string }) {
  return <section className="overflow-hidden rounded-2xl border border-[#e2ddcf] bg-[#fffdf8]">
    <div className={`flex items-start gap-4 px-5 py-6 sm:px-7 ${valid ? 'bg-[#e8f1e8]' : 'bg-[#fff0e9]'}`}>
      <div className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${valid ? 'bg-[#d0e6d2] text-[#246c55]' : 'bg-[#f3d7c9] text-[#a34f38]'}`}>{valid ? <BadgeCheck size={23} /> : <AlertCircle size={23} />}</div>
      <div><div className={`text-[17px] font-extrabold ${valid ? 'text-[#245943]' : 'text-[#93472f]'}`}>{valid ? 'Enregistrement démo trouvé' : 'Dossier non trouvé'}</div><p className={`mb-0 mt-1 text-sm leading-relaxed ${valid ? 'text-[#52695b]' : 'text-[#805b4e]'}`} data-testid="status-verification">{message}</p></div>
    </div>
    {record ? <div className="p-5 sm:p-7">
      <div className="mb-5 flex items-center justify-between border-b border-[#ece7dc] pb-4"><div><div className="text-[10px] font-bold uppercase tracking-[.16em] text-[#858a80]">Détail de l’exemple sauvegardé</div><div className="mono mt-1.5 text-xs text-[#617168]">{shortId(record.id)}</div></div><span className="rounded-full border border-[#ead1ad] bg-[#fff3df] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#a06a3e]">DÉMO</span></div>
      <div className="grid gap-x-4 gap-y-5 sm:grid-cols-2">
        <ReceiptDatum label="Conducteur" value={record.driverName} />
        <ReceiptDatum label="Catégorie" value={record.categoryLabel || categoryNames[record.vehicleCategory]} />
        <ReceiptDatum label="Plaque" value={record.licensePlate} mono />
        <ReceiptDatum label="Permis (démo)" value={record.permitNumber} mono />
        <ReceiptDatum label="Véhicule" value={`${record.vehicleMake ?? ''} ${record.vehicleModel ?? ''} · ${record.vehicleYear ?? '—'}`} />
        <ReceiptDatum label="Service prévu" value={`${record.serviceDate} · ${record.shiftStart ?? '—'}–${record.shiftEnd ?? '—'}`} mono />
        <ReceiptDatum label="Montant illustratif" value={money(record.amountFc)} />
        <ReceiptDatum label="Date d’enregistrement" value={dateText(record.createdAt)} />
      </div>
      <div className="mt-6"><DemoNotice compact /></div>
    </div> : <div className="p-6"><div className="text-xs text-[#86897f]">Référence demandée</div><div className="mono mt-1 break-all text-xs text-[#57685f]" data-testid="text-invalid-record-id">{id}</div></div>}
  </section>;
}

function Router() {
  return <Switch>
    <Route path="/"><AppFrame><Dashboard /></AppFrame></Route>
    <Route path="/records"><AppFrame><Records /></AppFrame></Route>
    <Route path="/new"><AppFrame><NewRecord /></AppFrame></Route>
    <Route path="/verify/:recordId"><AppFrame><Verification /></AppFrame></Route>
    <Route><NotFound /></Route>
  </Switch>;
}

function App() {
  const [splashOpen, setSplashOpen] = useState(true);
  const [splashStage, setSplashStage] = useState<0 | 1>(0);
  useEffect(() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stageTimer = window.setTimeout(
      () => setSplashStage(1),
      reducedMotion ? 200 : 700,
    );
    const closeTimer = window.setTimeout(
      () => setSplashOpen(false),
      reducedMotion ? 500 : 1600,
    );
    return () => {
      window.clearTimeout(stageTimer);
      window.clearTimeout(closeTimer);
    };
  }, []);
  return <QueryClientProvider client={client}>
    <WouterRouter base={import.meta.env.BASE_URL.replace(/\/$/, '')}><Router /></WouterRouter>
    {splashOpen && <section className="splash" aria-label="Présentation des marques de démonstration" data-testid="splash-intro">
      <button className="splash-dismiss" type="button" onClick={() => setSplashOpen(false)} aria-label="Fermer la présentation" data-testid="button-dismiss-splash">Passer</button>
      <div key={splashStage} className="splash-stack" aria-live="polite">
        <img
          src={splashStage === 0 ? vallLogo : antrArtwork}
          className={splashStage === 0 ? 'splash-vall' : 'splash-antr'}
          alt={splashStage === 0 ? 'Logo Vall Business' : 'Illustration ANTR fournie, sans affiliation vérifiée'}
          data-testid={splashStage === 0 ? 'splash-vall-logo' : 'splash-antr-logo'}
        />
        <div className="splash-label">{splashStage === 0 ? 'Vall Business' : 'ANTR Transport · image fournie'}</div>
        <div className="flag-rule w-36" role="img" aria-label="Couleurs du drapeau de la République démocratique du Congo" />
        <p className="max-w-xs px-5 text-center text-xs leading-relaxed text-[#d9e2ec]">Prototype indépendant. Aucune affiliation institutionnelle ni autorisation officielle n’est revendiquée.</p>
      </div>
    </section>}
  </QueryClientProvider>;
}